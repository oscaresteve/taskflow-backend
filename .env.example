# Plantilla de variables de entorno. Copiala a `.env` y ya funciona en local tal cual:
# los valores de aqui son los que esperan los contenedores de `docker-compose.yml`.
#
#   cp .env.example .env
#
# El servidor valida todas estas variables con zod al arrancar (`src/config/env.ts`), asi que si
# falta alguna o no cumple el formato, el proceso no arranca. Para produccion, mira
# `docs/despliegue.md`.

# Postgres del contenedor `postgres` de docker-compose.
DATABASE_URL="postgresql://taskflow:taskflow@localhost:5432/taskflow?schema=public"

PORT=4000
NODE_ENV=development

# Entre 10 y 15. Mas alto es mas lento a proposito.
BCRYPT_SALT_ROUNDS=12

# Minimo 32 caracteres cada uno, y distintos entre si. En local da igual lo que pongas;
# en produccion tienen que ser secretos de verdad.
JWT_ACCESS_SECRET=super-secret-jwt-access-key-for-taskflow-123456789-123456789
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=super-secret-jwt-refresh-key-for-taskflow-123456789-123456789
JWT_REFRESH_EXPIRES_IN=30d

# Origen del frontend. Lo usan el `cors()` de Express y, por separado, el servidor de socket.io.
# Admite un solo origen, no una lista.
CORS_ORIGIN="http://localhost:3000"

# Almacenamiento de archivos (hoy avatares de workspace; mas adelante, adjuntos de tareas).
# En local es el MinIO de docker-compose, que habla la API de S3. MinIO necesita path-style
# (`host/bucket/key`); R2 y S3 usan virtual-hosted-style.
S3_ENDPOINT="http://localhost:9000"
S3_REGION="us-east-1"
S3_ACCESS_KEY_ID="minioadmin"
S3_SECRET_ACCESS_KEY="minioadmin123"
S3_BUCKET_NAME="taskflow-avatars"
S3_FORCE_PATH_STYLE="true"
S3_PUBLIC_URL_BASE="http://localhost:9000/taskflow-avatars"
